# Store line endings as LF in the repository and check them out as LF,
# so the files are identical no matter which OS they are cloned on.
* text=auto eol=lf

*.py text eol=lf
*.html text eol=lf

# Binary files that must never be line-ending converted
*.sqlite3 binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
